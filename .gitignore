# Dependencies installed by `node scripts/setup.mjs`
node_modules/

# Generated lockfile: the setup scripts install with npm, but this repo ships
# no runtime dependencies of its own, so the lockfile is not authoritative.
package-lock.json

# Editor / OS noise
.DS_Store
Thumbs.db
*.log

# CodeGraph indexes (per-project, never committed)
.codegraph/

# Resolucion local de modelos por agente (config del usuario, no del toolkit)
.opencode/opencode.jsonc

# Orquestador: artefactos en tiempo de ejecución (telemetría, diffs, bundles, veredictos)
.opencode/run/
.opencode/cache/
