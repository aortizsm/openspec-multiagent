{
  "mcp": {
    "servers": {
      "openspec": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "openspec-mcp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "engram": {
        "type": "local",
        "command": [
          "engram",
          "mcp"
        ]
      },
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
        }
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/home/noesis/Desarrollos/MISC/opencode-openspec-multiagent"
        ]
      }
    },
    "market": {
      "type": "local",
      "command": ["node", "/home/noesis/Desarrollos/MISC/trading/bot/src/mcp/server.js"],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen36-35b-a3b",
  "default_agent": "architect",
  "providers": {
    "llamacpp": {
      "name": "llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:9931/v1"
      },
      "models": {
        "nemotron-3.5-lightning-30b-a3b": {
          "modelID": "nemotron-3.5-lightning-30b-a3b",
          "name": "Nemotron 3.5 Lightning 30B A3B (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        },
        "qwen35-9b": {
