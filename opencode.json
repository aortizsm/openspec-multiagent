    "opencode-go": {
      "name": "OpenCode Go (Zen)",
      "package": "@ai-sdk/openai-compatible",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "settings": {
        "baseURL": "https://opencode.ai/inference/go/openai/v1/chat/completions"
      }
    }
  },
  "agents": {
    "build": {},
    "plan": {},
    "general": {},
    "explore": {},
    "architect": {
      "mode": "primary",
      "description": "Architects whole implementations. Drives the spec-driven loop; never writes code."
    },
    "developer": {
      "mode": "subagent",
      "description": "Implementa código PHP (Moodle local plugin), FastAPI y specs OpenSpec."
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Revisa cambios contra las specs OpenSpec, seguridad, reglas de oro y tests."
    },
    "diff-summarizer": {
      "mode": "subagent",
      "description": "Resume diffs de git y señala puntos de riesgo."
    },
    "repo-scout": {
      "mode": "subagent",
      "description": "Reporta stack, convenciones y comandos del repositorio."
    },
    "verifier": {
      "mode": "subagent",
      "description": "Independent verification agent: executes project commands, maps spec scenarios to observable evidence. No-write policy."
    },
    "security-reviewer": {
      "mode": "subagent",
      "description": "Evaluates code against 12 language-agnostic security criteria. Tags findings CRITICAL/WARNING/SUGGESTION."
    }
  }
}
